<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFE0">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Habits"
            android:textColor="#2B2B2B"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginBottom="16dp" />

        <!-- Placeholder list -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:text="Drink 8 glasses of water"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <CheckBox
                android:text="Study 1 hour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <CheckBox
                android:text="Exercise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/dailyProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="50"
            android:layout_marginTop="20dp"
            android:progressTint="#BCCBA3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streak: 3 Days 🔥"
            android:textColor="#4B6B67"
            android:textSize="16sp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/addHabitBtn"
            android:text="Add Habit"
            android:backgroundTint="#BCCBA3"
            android:textColor="#2B2B2B"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/progressBtn"
                android:text="Progress"
                android:backgroundTint="#AFB2C9"
                android:textColor="#2B2B2B"
                android:layout_margin="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/achievementsBtn"
                android:text="Achievements"
                android:backgroundTint="#FFD6A4"
                android:textColor="#2B2B2B"
                android:layout_margin="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/settingsBtn"
                android:text="Settings"
                android:backgroundTint="#E6C4C3"
                android:textColor="#2B2B2B"
                android:layout_margin="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
